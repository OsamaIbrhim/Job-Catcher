# =============================================================
# Copy this file to .env and fill in the values. Never commit
# .env to GitHub. Run `npm run doctor` after filling it in to
# confirm everything is set up correctly.
# =============================================================

# --- Telegram: personal account (MTProto via GramJS) ---
# From my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Empty at first. Get it by running: npm run login
# Warning: this is exactly like your password — never share it.
TG_SESSION=

# --- Telegram: bot (Bot API) ---
# From @BotFather on Telegram
BOT_TOKEN=

# Empty at first. Get it by running: npm run channel-id
# (after confirming the bot is an admin of your private channel)
# Note: private channel ids always start with -100
CHANNEL_ID=

# --- MongoDB Atlas (M0 free tier) ---
# From mongodb.com/atlas -> Connect -> Drivers
MONGODB_URI=

# --- AI analysis layer (optional, free tier) ---
# From aistudio.google.com/apikey
GEMINI_API_KEY=

# Set to "false" to disable the AI layer instantly and fall back to
# keyword-only filtering + regex parsing. Defaults to on (anything
# other than the literal string "false" is treated as enabled).
AI_ENABLED=

# Optional: override the Gemini model id (default: gemini-3.6-flash)
GEMINI_MODEL=

# --- Monthly cleanup of the `jobs` collection (optional) ---
# How many days of job postings to keep before they're deleted.
# Never touches sent_hashes (its own TTL handles that) or meta.
RETENTION_DAYS=60

# How often the automatic cleanup is allowed to run, at most.
CLEANUP_INTERVAL_DAYS=30
