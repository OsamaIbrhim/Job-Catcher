# Copy this file to .env.local for local development. Never commit
# .env.local — it's already in the root .gitignore.
#
# Server-side only. This is read exclusively in dashboard/lib/db.js
# (a server-only module) and is never exposed to the browser — do
# NOT rename it to NEXT_PUBLIC_MONGODB_URI, that would ship it to
# every visitor's browser.
MONGODB_URI=
